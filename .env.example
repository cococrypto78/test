# ── AI ─────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=4096

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sales_agents
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LinkedIn ───────────────────────────────────────────────────────────────────
LINKEDIN_EMAIL=your@email.com
LINKEDIN_PASSWORD=yourpassword

# ── Twitter / X ────────────────────────────────────────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# ── Instagram ──────────────────────────────────────────────────────────────────
INSTAGRAM_USERNAME=yourusername
INSTAGRAM_PASSWORD=yourpassword

# ── TikTok ─────────────────────────────────────────────────────────────────────
TIKTOK_USERNAME=yourusername
TIKTOK_PASSWORD=yourpassword

# ── Email / SMTP ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your@gmail.com
SMTP_FROM_NAME=Your Name

# ── Alertes humain ─────────────────────────────────────────────────────────────
HUMAN_ALERT_EMAIL=you@yourdomain.com
# Webhook Slack/Teams (optionnel)
WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ── API Security ───────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-random-32char-string!!
# Générer le hash avec: python -c "from passlib.context import CryptContext; print(CryptContext(['bcrypt']).hash('yourpassword'))"
API_USERNAME=admin
API_PASSWORD_HASH=$2b$12$your.bcrypt.hash.here

# ── Rate Limits (par jour) ─────────────────────────────────────────────────────
MAX_DAILY_CONNECTIONS_LINKEDIN=15
MAX_DAILY_DMS_INSTAGRAM=40
MAX_DAILY_DMS_TWITTER=80
MAX_DAILY_EMAILS=150
MAX_DAILY_DMS_TIKTOK=20

# ── Proxies (optionnel, virgule-séparés) ───────────────────────────────────────
PROXY_LIST=

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
API_PORT=8000
