# ── Email (server-side via Postmark) ───────────────────────────────────────────
POSTMARK_SERVER_TOKEN=
EMAIL_SENDING_DOMAIN=

# ── Twitter/X (API officielle v2) ──────────────────────────────────────────────
X_API_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ── Instagram (Meta Graph API, optionnel) ──────────────────────────────────────
# Requis uniquement si le tenant configure un compte Business Instagram
META_GRAPH_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ── LinkedIn + TikTok : MODE PASTE UNIQUEMENT, aucune credential serveur ───────
# Ces canaux fonctionnent en mode "copier-coller assisté". L'utilisateur
# ouvre le lien dans son navigateur et clique lui-même sur Envoyer.

# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_DRAFTING_MODEL=claude-sonnet-4-6
CLAUDE_CLASSIFICATION_MODEL=claude-haiku-4-5-20251001

# ── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Database / Redis ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://sales_agent:<pwd>@localhost:5432/sales_agent_prod
REDIS_URL=redis://:<pwd>@localhost:6379/0

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=production
SECRET_KEY=
API_PORT=8000
LOG_LEVEL=INFO

# ── Monitoring ─────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Backup (Scaleway Object Storage) ──────────────────────────────────────────
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_BUCKET_NAME=
SCW_REGION=fr-par

# ── Rate Limits (par jour, par tenant) ─────────────────────────────────────────
MAX_DAILY_MESSAGES_PER_TENANT=100
